{
	// The plugin's entry module and the mods' state contracts, which the
	// release composes into the one the root plugin.json names, checked against
	// the engine's types. The liveness mod's copy of those is the newer, and
	// only one engine `declare module "claude-code"` may load.
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"types": [],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		// The entry #903 F4 loaded imported each mod by its full filename.
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment"
	},
	"include": [
		"register.ts",
		"../.claude/skills/wfc-liveness/.claude-plugin/types",
		"../.claude/skills/wfc-liveness/types",
		"../.claude/skills/wfc-delivery/types"
	]
}
