{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*npm *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*node *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*next *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*python*)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*pytest*)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*npx *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*yarn *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*pnpm *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*bun *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*make *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*cargo *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*go test*)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-suite-concurrency.js",
						"if": "Bash(*tsc*)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-vitest-wrapper.js",
						"if": "Bash(*vitest *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-vitest-wrapper.js",
						"if": "Bash(*npx *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-unasked-rerun.js",
						"if": "Bash(*npm *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-root-find.js",
						"if": "Bash(*find *)",
						"timeout": 30,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-ugrep-pattern.js",
						"if": "Bash(grep *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-wide-read.js",
						"if": "Bash(*cat *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-wide-read.js",
						"if": "Bash(*sed *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-wide-read.js",
						"if": "Bash(*awk *)",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash|Write|Edit|NotebookEdit|Skill|Read|ListAgents|Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-dispatch.js",
						"timeout": 60,
						"onFailure": "block"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash|Read|Write|Edit|NotebookEdit|WebFetch|WebSearch",
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-dispatch.js",
						"timeout": 15
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PROJECT_DIR}/scripts/place-new-issue.sh",
						"if": "Bash(gh *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/record-issue-claim.js",
						"if": "Bash(gh *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/release-issue-claim.js",
						"if": "Bash(gh *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/record-acts.js",
						"if": "Bash(gh *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/record-divergence.js",
						"if": "Bash(git *)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/start-lander-on-push.js",
						"if": "Bash(*push*)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-lost-verdict.js",
						"if": "Bash(*test*)",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-lost-verdict.js",
						"if": "Bash(*test*)",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-failed-call-rules.js",
						"timeout": 10
					}
				]
			}
		],
		"PostToolBatch": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-failed-call-rules.js",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/name-issue-session.sh",
						"timeout": 30
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/inject-tracker-docs.sh",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR\"/scripts/inject-founder-wording.js",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/unpark-on-prompt.js || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/mark-presence.js || true",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/concision-backstop.sh stop",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-priced-options.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-inventory.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-jev-advisory.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-selection-sum.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-uncommitted-work.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-session-ceiling.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-lost-deny.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-automode-refusal.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-unpushed-commits.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/guard-paste-self-match.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/park-on-round.js || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/refill-wake.sh",
						"timeout": 5
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/clear-rule-latch.sh",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/inject-compaction-count.js || true",
						"timeout": 10
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/inject-compaction-count.js || true",
						"timeout": 10
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/write-self-plugin-marker.sh",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/replay-notify-reports.js --notify || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-plugin-gap.js --notify || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/concision-backstop.sh start",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/name-issue-session.sh",
						"timeout": 30
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/inject-tracker-docs.sh",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/session-arbiter.js prune-markers --detach || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sweep-debts-detached.sh",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && WFC_NOTIFY_PERSIST=1 node \"$CLAUDE_PROJECT_DIR\"/scripts/check-ci-status.js --notify || true",
						"timeout": 40,
						"async": true
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/reap-orphan-hooks.js --notify || true",
						"timeout": 60
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-orphan-wait-loops.js --notify || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-kernel-stall.js --notify || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-refill-loop-stop.js --notify || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-harness-canary.js --notify || true",
						"timeout": 15
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-orphaned-edits.js --notify || true",
						"timeout": 60
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/audit-escape-lines.js --notify || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/check-seat-utilisation.js --notify || true",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && WFC_NOTIFY_PERSIST=1 node \"$CLAUDE_PROJECT_DIR\"/scripts/reap-finished-sessions.js --notify || true",
						"timeout": 65,
						"async": true
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR\"/scripts/reconcile-plugin.js --session-end || true",
						"timeout": 400
					}
				]
			}
		]
	}
}
