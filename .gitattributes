# Vendored skills (skills-lock.json): the shell gates and formatters skip them,
# as docs/code-standards.md's route row sends them to "none" (#1828).
.agents/skills/** linguist-vendored
# Merged per row by scripts/merge-registry-anchors.js, which install-hooks.js
# defines; the gate then names each row both sides moved (#4171).
.claude/guard-registry-anchors.json merge=registry-anchors
# Appended by file-issue.js from many sessions at once; a union merge keeps
# every side's lines (#4796).
docs/data/outcome-signatures.jsonl merge=union
