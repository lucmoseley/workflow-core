#!/usr/bin/env sh
# prepare-commit-msg — runs the gate stack on a commit or merge `pre-commit` did
# not gate, `--no-verify` among them, and gitleaks alone on a replay
# (mantahostels#1705, mantahostels#1706); refuses a message that would close an
# issue (#138).
#
# `--no-verify` skips `pre-commit`, `commit-msg` and `pre-merge-commit`, and
# skips THIS hook on none of them — measured on git 2.43.0 at mantahostels#1705 and pinned
# by scripts/prepare-commit-msg-gate.test.ts. So this is where the two
# spellings `git merge --no-verify` and `git commit --no-verify` meet the
# gates.
#
# IMPLICIT:  runs the whole of .husky/pre-commit over the staged (or merge)
#            content, on every commit that reaches this hook — EXCEPT on the
#            replay path below (cherry-pick, rebase, `rebase --continue`),
#            where it runs gitleaks alone and, on a cherry-pick, the review hold
#            (mantahostels#1706, #3905).
#            It also refuses a message carrying a GitHub closing keyword before
#            an issue reference, on every route but a replay and a message
#            still to be typed into $EDITOR (#138). On a commit that passes,
#            writes the review hold's `Review-Tier:` trailer through
#            scripts/review-tier-trailer.js (#3664), which refuses a tree that
#            moved after the hold passed and fails the hold on re-reading it
#            (#3905). Every step is a row of
#            scripts/lib/prepare-commit-msg-rows.js, run in one Node process
#            by scripts/prepare-commit-msg-dispatch.js (#5207), which reads
#            the route through scripts/lib/commit-route.js; a missing
#            dispatcher refuses every commit.
# JUSTIFIED: fail-safe — this is the one hook that can refuse a commit and
#            that `--no-verify` leaves running, and a gate skipped here runs next
#            only in CI, after the push.
# DEFEAT:    `HUSKY=0`, and `core.hooksPath` pointed off `.husky/_`, which
#            turn off every hook in the repo at once.
#            `scripts/guard-dispatch.js` (its `guard-commit-form` core) denies `--no-verify`
#            on `git commit`, `git merge`, `git rebase`, `git cherry-pick` and
#            `git revert` in an agent session unless wrapped;
#            `scripts/lib/commit-form.js`'s LIMITS holds the whole defeat list (#800). Which
#            binary the replay path's scan runs is named by WFC_GITLEAKS (§N7,
#            #224).
#
# A refusal aborts the operation: git exits 1 and writes no commit. On a merge
# it leaves the merge IN PROGRESS with MERGE_HEAD set, exactly as a
# `pre-merge-commit` refusal does — `.husky/pre-merge-commit`'s header has what
# that strands and how to clear it.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)
# The repo this hook runs in, not an inherited CLAUDE_PROJECT_DIR (#3307); skipped where the lib is missing.
# shellcheck source=scripts/lib/hook-root.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh"

here="$(dirname "$0")"
dispatcher="${WFC_PLUGIN_ROOT:-$here/..}/scripts/prepare-commit-msg-dispatch.js"

# The route decides between the whole stack and gitleaks alone, so a
# dispatcher that cannot read it refuses rather than guessing either (#1503).
if [ ! -r "$dispatcher" ]; then
  echo "prepare-commit-msg: $dispatcher is missing, so this commit's route cannot be read." >&2
  echo "  Refusing rather than gating it as an ordinary commit (#1503)." >&2
  exit 1
fi

# Unbounded, so no scripts/lib/hook-bound.sh: the dispatcher runs the whole
# of .husky/pre-commit inline, which bounds its own checkers and runs its slow
# gates under ceilings of their own, past any checker limit (#4187).
node "$dispatcher" --husky "$here" "$@"
