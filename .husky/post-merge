#!/usr/bin/env sh
# post-merge — keeps the shims live sessions need at hook scripts a merge
# deleted from this checkout (#2879). A port often lands by merge, which never
# fires post-commit.
#
# IMPLICIT:  where a shim exists or a script was deleted since the keeper's last run, writes an exit-0 shim at each hook script a live session's hook lines still name but the main checkout no longer has, and deletes each shim no live session needs.
# JUSTIFIED: fail-safe — a session started before a port runs its old hook line until it ends, and a deleted script on a fail-closed line refuses every call that line matches; git ignores post-merge's exit status.
# DEFEAT:    no flag; skipped when scripts/keep-hook-shims.js or node is missing.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)
# The repo this hook runs in, not an inherited CLAUDE_PROJECT_DIR (#3307); skipped where the lib is missing.
# shellcheck source=scripts/lib/hook-root.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh"

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
script="${WFC_PLUGIN_ROOT:-$toplevel}/scripts/keep-hook-shims.js"
[ -f "$script" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

# git exports GIT_DIR and GIT_INDEX_FILE into a hook; post-commit's
# report_new_shared_faults says why each is unset. The keeper always exits 0.
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE node "$script" --lazy
