#!/usr/bin/env sh
# commit-msg — refuses a commit message that would close an issue (#138), a
# subject over 72 characters (#2332), and a commit weakening a check whose
# message does not name it (#2235).
#
# The only hook that sees a commit message typed into $EDITOR: `prepare-commit-msg`
# runs BEFORE the editor opens and is handed an empty file (measured at #138).
# So this is the sole seam at which the editor route can be refused.
#
# IMPLICIT:  scans this commit's finished message for a GitHub closing keyword
#            before an issue reference and refuses the commit on a hit
#            (docs/agents/rules/commit-closes-keyword.txt), and a subject over
#            72 characters (scripts/lib/commit-subject.js), on every route
#            but a replay. Then, but on a merge, refuses a commit whose
#            staged diff weakens a check its message names on no `Weakens:`
#            line (scripts/check-weakens-line.js). All three run in one Node
#            process, scripts/commit-msg-dispatch.js (lib/commit-msg-rows.js,
#            #5207), whose absence refuses every commit. Last, on every route a
#            replay included, sources the adopter's own
#            `.husky/commit-msg.local` where it exists, after
#            refusing every commit on a script it names that the repo lacks
#            (scripts/lib/local-hook.sh).
# JUSTIFIED: fail-safe — the keyword closes the issue server-side on the push,
#            so the guard-issue-close core never fires and the issue closes with no
#            resolution comment and no `**Outstanding:**` line (#118); a
#            subject over 72 characters breaks `git log --oneline` (#2172); and a
#            check weakened inside a large commit goes unseen until it bites
#            (#2203).
# DEFEAT:    `--no-verify`, which DOES skip this hook (unlike
#            `prepare-commit-msg`), plus `HUSKY=0` and `core.hooksPath`
#            pointed off `.husky/_`. `scripts/guard-dispatch.js` (its `guard-commit-form` core)
#            denies `--no-verify` in an agent session unless wrapped;
#            `scripts/lib/commit-form.js`'s LIMITS holds the whole defeat list
#            (#800).
#
# A refusal aborts the commit: git exits 1 and writes nothing.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)
# The repo this hook runs in, not an inherited CLAUDE_PROJECT_DIR (#3307); skipped where the lib is missing.
# shellcheck source=scripts/lib/hook-root.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh"
# Every `node` and `bash` below under one wall-clock limit (#4187); unbounded where the lib is missing.
# shellcheck source=scripts/lib/hook-bound.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-bound.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-bound.sh"

here="$(dirname "$0")"
dispatcher="${WFC_PLUGIN_ROOT:-$here/..}/scripts/commit-msg-dispatch.js"
local_lib="${WFC_PLUGIN_ROOT:-$here/..}/scripts/lib/local-hook.sh"

# FAIL CLOSED on a missing script rather than passing the message unread.
# Each worktree runs its own copy of this hook and resolves its own scripts/
# (scripts/install-hooks.js, #3138), so a file is absent only where that tree
# is incomplete, or where a fixture copied the hooks without it.
# require <path> <what did not run> <why refusing>
require() {
  [ -r "$1" ] && return 0
  echo "commit-msg: $1 is missing, so $2." >&2
  echo "  Refusing rather than $3." >&2
  exit 1
}
require "$dispatcher" "the message checks did not run" "passing the message unread (#138)"
require "$local_lib" ".husky/commit-msg.local cannot be checked" "running the adopter's refusals unchecked (#5142)"
# shellcheck source=scripts/lib/local-hook.sh
. "$local_lib"

# The closing-keyword scan and the subject check stand down on a replay, and
# the Weakens: check on a merge too: lib/commit-msg-rows.js. A refusal aborts
# the commit with the dispatcher's own code, through `set -e`.
node "$dispatcher" "$1"

# THE ADOPTER'S OWN REFUSALS: `.husky/commit-msg.local` (#5142), on
# `.husky/pre-commit.local`'s contract (#437): last, only where it exists,
# SOURCED in this `sh -e` shell, so `$1` is the message file and any failing
# command or `exit 1` refuses the commit; core never writes it; and a script it
# names that the repo lacks refuses every commit. It runs on every route, a
# replay included: `$route` names it, and the adopter stands down for itself.
if [ -f .husky/commit-msg.local ]; then
  # shellcheck disable=SC2034 # read by the sourced .local file below
  route="$(node "$dispatcher" --print-route)"
  wfc_local_hook_refuse_missing .husky/commit-msg.local \
    "commit-msg: .husky/commit-msg.local calls a script this repo does not have:"
  # shellcheck source=/dev/null # the adopter's own optional gate, absent from most repos
  . ./.husky/commit-msg.local
fi
