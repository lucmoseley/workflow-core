#!/usr/bin/env sh
# commit-msg — refuses a commit message that would close an issue (#138), a
# subject over 72 characters (#2332), and a commit weakening a check whose
# message does not name it (#2235).
#
# The only hook that sees a commit message typed into $EDITOR: `prepare-commit-msg`
# runs BEFORE the editor opens and is handed an empty file (measured at #138).
# So this is the sole seam at which the editor route can be refused.
#
# IMPLICIT:  scans this commit's finished message for a GitHub closing keyword
#            before an issue reference and refuses the commit on a hit
#            (docs/agents/rules/commit-closes-keyword.txt), and a subject over
#            72 characters (scripts/check-commit-subject.sh), on every route
#            but a replay. A missing scanner, subject check or
#            scripts/lib/commit-route.sh refuses every commit. Then, but on a merge, refuses a commit whose
#            staged diff weakens a check its message names on no `Weakens:`
#            line (scripts/check-weakens-line.js).
# JUSTIFIED: fail-safe — the keyword closes the issue server-side on the push,
#            so the guard-issue-close core never fires and the issue closes with no
#            resolution comment and no `**Outstanding:**` line (#118); a
#            subject over 72 characters breaks `git log --oneline` (#2172); and a
#            check weakened inside a large commit goes unseen until it bites
#            (#2203).
# DEFEAT:    `--no-verify`, which DOES skip this hook (unlike
#            `prepare-commit-msg`), plus `HUSKY=0` and `core.hooksPath`
#            pointed off `.husky/_`. `scripts/guard-dispatch.js` (its `guard-commit-form` core)
#            denies `--no-verify` in an agent session unless wrapped;
#            `scripts/lib/commit-form.js`'s LIMITS holds the whole defeat list
#            (#800).
#
# A refusal aborts the commit: git exits 1 and writes nothing.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)

here="$(dirname "$0")"
scanner="${WFC_PLUGIN_ROOT:-$here/..}/scripts/check-commit-message-closes.sh"
subject_check="${WFC_PLUGIN_ROOT:-$here/..}/scripts/check-commit-subject.sh"
route_lib="${WFC_PLUGIN_ROOT:-$here/..}/scripts/lib/commit-route.sh"

# FAIL CLOSED on a missing script rather than passing the message unread.
# Each worktree runs its own copy of this hook and resolves its own scripts/
# (scripts/install-hooks.js, #3138), so a file is absent only where that tree
# is incomplete, or where a fixture copied the hooks without it.
# require <path> <what did not run> <why refusing>
require() {
  [ -r "$1" ] && return 0
  echo "commit-msg: $1 is missing, so $2." >&2
  echo "  Refusing rather than $3." >&2
  exit 1
}
require "$scanner" "the closing-keyword scan did not run" "passing the message unread (#138)"
require "$subject_check" "the subject was not measured" "passing the subject unmeasured (#2332)"
require "$route_lib" "this commit's route cannot be read" "scanning a replayed message as a new one (#1503)"
# shellcheck source=scripts/lib/commit-route.sh
. "$route_lib"

# THE REPLAY STAND-DOWN (#138): the replay routes that reach this hook stand down
# here as in `.husky/prepare-commit-msg`, for the reasons its own header gives.
gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null || :)"
route="$(wfc_commit_route commit-msg "$gitdir")"
if wfc_commit_route_replays "$route"; then
  exit 0
fi

bash "$scanner" "$1" commit-msg
bash "$subject_check" "$1" commit-msg

# A commit that weakens a check names each weakening on a `Weakens:` line
# (#2235). This is the one hook holding both the finished message and the
# commit's index. A merge stands down: the lines it joins were judged at their
# own commits.
if [ "$route" != merge ]; then
  node "${WFC_PLUGIN_ROOT:-$here/..}/scripts/check-weakens-line.js" "$1"
fi
