#!/usr/bin/env sh
# pre-applypatch — the secrets scan on `git am` and `git rebase --apply`
# (mantahostels#1707).
#
# Neither route reaches `pre-commit` or `prepare-commit-msg` (the marker table
# in scripts/lib/commit-route.sh), and `pre-applypatch` is the only hook either
# offers that can refuse: git aborts the apply on a non-zero exit, before the
# commit is written.
#
# IMPLICIT:  runs gitleaks over the applied patch's staged content, on every
#            `git am` and every `git rebase --apply` replay, through
#            scripts/lib/commit-route.sh, whose absence refuses the apply.
# JUSTIFIED: fail-safe — a patch applied from a file is bytes no commit in this
#            repository ever carried, which is the shape a pasted credential
#            arrives in, and AGENTS.md §Secrets boundary makes a committed key
#            permanent. A gate skipped here runs next only in CI, after the
#            push, by which time the key is published.
# DEFEAT:    `git am --no-verify`, which abbreviates down to `--no-v`, skips
#            this hook; `git rebase --apply` accepts no such flag.
#            `scripts/guard-dispatch.js` (its `guard-commit-form` core) denies the flag only
#            unwrapped, so an agent can still reach it; that core's
#            LIMITS (`scripts/lib/commit-form.js`) holds every route past this
#            hook (#800). WFC_GITLEAKS
#            names the scanner's binary (§N7, #224), which on this hook is the
#            whole gate.
#
# gitleaks ALONE, never the whole stack — the same call and the same reasoning
# as .husky/prepare-commit-msg's replay path (mantahostels#1706): a rebase replaying N
# commits would otherwise run N full stacks, and an intermediate state can
# legitimately fail a cross-file check that only the final state satisfies.
# THE RESIDUAL is everything else in .husky/pre-commit, unrun on these two
# routes.
#
# A refusal leaves the operation IN PROGRESS with `rebase-apply/` set, so the
# message names the abort, which differs between the two routes:
# scripts/lib/commit-route.sh tells them apart and owns the scan.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)
# The repo this hook runs in, not an inherited CLAUDE_PROJECT_DIR (#3307); skipped where the lib is missing.
# shellcheck source=scripts/lib/hook-root.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh"

here="$(dirname "$0")"
route_lib="${WFC_PLUGIN_ROOT:-$here/..}/scripts/lib/commit-route.sh"
if [ ! -r "$route_lib" ]; then
  echo "pre-applypatch: $route_lib is missing, so the secrets scan did not run." >&2
  echo "  Refusing rather than applying the patch unscanned (#1503)." >&2
  exit 1
fi
# shellcheck source=scripts/lib/commit-route.sh
. "$route_lib"

gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null || :)"
wfc_replay_scan pre-applypatch "$(wfc_commit_route pre-applypatch "$gitdir")" && exit 0
exit 1
