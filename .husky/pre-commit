#!/usr/bin/env sh
# pre-commit — the gate stack every commit runs, refusing it on a gating red: the
# last local gate, nothing running on push (mantahostels#910).
#
# Borrow the canonical checkout's binaries, since a worktree has no node_modules
# of its own, by an absolute path, since a gate may run from another directory
# (#4079). These gates fire in a worktree too, from that
# worktree's own copy of this file, because `prepare`'s install-hooks.js re-pins
# core.hooksPath absolute after husky writes it relative and points husky's
# shim at the committing tree (#3138). Revert that pin and every gate below
# silently stops firing in worktrees; nothing reports it (mantahostels#344).
#
# IMPLICIT:  runs every gate below on each commit — the shared-tree branch check, the linters, the secret scan and the repo checkers — and refuses the commit on a red. Deliberately not enumerated: this file has carried ~14 gates and gains more, and a list here is one that goes stale (mantahostels#1261).
# JUSTIFIED: fail-safe — a commit is the last local moment before work is shared, and a gate skipped here runs next only in CI, after the push: with `landing` on, the lander's run on that push (#2413).
# RUNS:      gates — each program below is judged by its own guard-registry row where a rule names it (#4456).
# DEFEAT:    WFC_ALLOW_BRANCH=1 skips the shared-tree branch check alone, and WFC_ALLOW_GATE_INPUT_DELETE=1 lets one commit delete a staged gate's own required input, for the rare deliberate retirement (mantahostels#2894; the limb is in scripts/lib/precommit-gate.sh, so it reaches every staged_gate caller at once). Both are the founder's to set, and the guard-hook-escape core refuses an agent's spelling of either (#916). WFC_GITLEAKS names the secret scanner's binary (§N7, #224), so a value that exits 0 on everything defeats the scan alone. Its one argument, `--gates=merge` or `--gates=batch`, narrows a run the queue lander makes itself (#4545); git passes none, so no commit reaches it. The stack itself has no escape flag: --no-verify does not skip it, since .husky/prepare-commit-msg runs it and is the one hook that can refuse a commit and that the flag leaves running (mantahostels#1705), and the guard-commit-form core denies that flag on `git commit` and `git merge` both. Defeats remain: HUSKY=0 among those disarming every hook (the whole list: scripts/lib/commit-form.js's LIMITS), and a caller setting WFC_TEST_STAMP or WFC_MUTATION_STAMP by hand to a stamp it wrote itself in the git directory, which stands the declared test gate or the mutation hold down (scripts/lib/commit-key.js, scripts/mutation-hold-gate.js; #1650, #1910).

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (#745)
# The repo this hook runs in, not an inherited CLAUDE_PROJECT_DIR (#3307); skipped where the lib is missing.
# shellcheck source=scripts/lib/hook-root.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-root.sh"
# Every `node` and `bash` below under one wall-clock limit (#4187); unbounded where the lib is missing or defines no hook_bound (#4266).
# shellcheck source=scripts/lib/hook-bound.sh
[ ! -r "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-bound.sh" ] || . "${WFC_PLUGIN_ROOT:-$(dirname "$0")/..}/scripts/lib/hook-bound.sh"
command -v hook_bound >/dev/null 2>&1 || hook_bound() { "$@"; }

# The pre-lock stamps the test gate and the mutation hold below may stand down
# on (#1650, #1910), read once and unset here so no gate's child — the in-lock
# suite, and any commit it makes in a fixture repo — inherits them.
tg_stamp="${WFC_TEST_STAMP:-}"
mh_stamp="${WFC_MUTATION_STAMP:-}"
unset WFC_TEST_STAMP WFC_MUTATION_STAMP

PATH="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/node_modules/.bin:$PATH"

# The shape the staged gates below share — the temp-dir lifecycle, the staging
# of blobs out of the index, the skip line and the direction gate's exit-code
# alphabet (mantahostels#1793). A git hook runs with the working tree's top as its cwd, and
# scripts/ is tracked, so a worktree AT OR AFTER mantahostels#1793's commit resolves it too;
# an older detached one does not, and every commit there aborts on the missing
# source until it is moved forward.
#
# COMMIT THEM TOGETHER. This file and the two libraries below are one unit: a
# pathspec commit naming only one of them lands a hook that cannot source what
# it needs, which aborts every commit in the repo until the other half follows.
# shellcheck source=scripts/lib/precommit-gate.sh
. "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/precommit-gate.sh
# shellcheck source=scripts/lib/local-hook.sh
. "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/local-hook.sh

# Layer two of mantahostels#100's shared-tree pin, and the one that actually holds: the
# PreToolUse guard (the guard-branch core of scripts/guard-dispatch.js) reads a command string and fails
# open, and sees nothing at all in a plain terminal. A linked worktree is exempt
# — it was created for a branch and no other session moves it; --git-dir and
# --git-common-dir are the same directory only in the main worktree.
#
# symbolic-ref, not rev-parse --abbrev-ref: it names the branch even before the
# first commit exists (where --abbrev-ref answers the literal "HEAD" and would
# block a fresh repo's initial commit), and fails when HEAD is detached, which
# is correctly a block.
branch="$(git symbolic-ref --quiet --short HEAD || echo 'a detached HEAD')"
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] &&
  [ "$branch" != "main" ] &&
  [ -z "${WFC_ALLOW_BRANCH:-}" ]; then
  echo "pre-commit: the shared working tree is on '$branch', not main." >&2
  echo "  The tree is repo-global: committing here lands your work on another session's branch (mantahostels#87)." >&2
  echo "  Return it with 'git checkout main', and do branch work in a throwaway worktree." >&2
  echo "  Deliberate? The escape is the founder's to set, never an agent's (#916): an agent stops and asks. The founder runs, from their own terminal, WFC_ALLOW_BRANCH=1 git commit -m '…' -- <paths>  — never --no-verify, which also skips gitleaks." >&2
  exit 1
fi

# The queue lander's two gate sets (#4545). `--gates=merge` runs on each member's merge: the guard-registry
# gate, which refuses members in practice and writes the anchor carry only a
# merge can make (#4514). `--gates=batch` runs once over the whole
# batch staged against `main`: every other gate, bar those the lander's Actions
# run repeats before `main` moves, each marked `lander_batch` below.
wfc_gates=all
case "${1-}" in
  --gates=merge | --gates=batch) wfc_gates="${1#--gates=}" ;;
esac

# The Node gates, every row of scripts/lib/precommit-gates.js, in its order,
# in one process sharing one startup (#5172). It takes this hook's arguments,
# so `--gates=` selects the lander's sets there; a gate's red is its own exit
# code. The registry row holds each gate's arm and why.
node "${WFC_PLUGIN_ROOT:-.}"/scripts/precommit-dispatch.js "$@" || exit "$?"

if [ "$wfc_gates" = merge ]; then
  exit 0
fi

# Scoped to the commit's own paths, not the whole repo (mantahostels#179): a
# whole-repo `biome check .` here fails on an unformatted file the commit does
# not touch. scripts/biome-staged.js runs Biome on an extraction of the index,
# so it checks the bytes this commit carries, not the unstaged hunks of a file
# it patches (#2429). Whole-repo Biome stays in ci.yml, on its schedule
# (mantahostels#910).
#
# THE COMMAND IS THE ADOPTER'S, from .claude/workflow-core.json (#2), here and in
# the typecheck and ESLint gates below; declared_cmd owns the reader's exit codes.
# One that runs `biome check --staged`, itself or through the package.json
# script an npm, pnpm, yarn or bun run names, is refused before it runs
# (#2731); node is spent only on a command that could (#2775): one holding a
# package manager's name, `biome`, a quote, backslash, expansion or brace hiding
# those words (#3414, #3445, #3545), a glob, or `parallel` or a shell word,
# `?sh` and `?ash` standing for the shells, as lib/infer-commands.js's SHELLS,
# that can run what the text never names (#3851). The first arm is
# biome-allowlist.js's BIOME_STAGED_COMMAND, which is never classified.
if ! lander_batch && declared_cmd node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/workflow-core-config.js command check_staged; then
  blank=$(printf '\t\n_')
  blank=${blank%_}
  case "$declared_command" in
    'node "$WFC_PLUGIN_ROOT"/scripts/biome-staged.js'*) ;;
    *)
      case " $declared_command " in
        *npm* | *yarn* | *bun* | *npx* | *biome* | *parallel* | *[\\\'\"$\`\{*?\[]* | \
          *["$blank"\ /\;\&\|\(]sh["$blank"\ \;\&\|\)\<\>]* | *["$blank"\ /\;\&\|\(]?sh["$blank"\ \;\&\|\)\<\>]* | *["$blank"\ /\;\&\|\(]?ash["$blank"\ \;\&\|\)\<\>]*)
          node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/infer-commands.js check-staged "$declared_command" || exit "$?"
          ;;
      esac
      ;;
  esac
  sh -c "$declared_command" || exit 1
fi

hook_bound "${WFC_GITLEAKS:-gitleaks}" git --staged --redact || exit 1

# The roadmap HTML and its digest must agree on their version line (mantahostels#910).
# The dispatcher's roadmap-pair row catches the half-staged PAIR; this catches
# the pair staged together with drifted versions.
#
# Fed from the INDEX, not the worktree: reading the files in place would judge
# a half-written digest the commit does not carry.
if ! lander_batch && armed '^(docs/reference-roadmap\.html|docs/roadmap-digest\.md)$'; then
  staged_gate digest-version live status \
    'docs/reference-roadmap.html docs/roadmap-digest.md' \
    'node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-digest-version.js "$sg_dir/reference-roadmap.html" "$sg_dir/roadmap-digest.md"' \
    ""
fi

# The digest's bytes are what its generator renders, not merely a matching
# version line (mantahostels#2890). docs/roadmap-digest.md is `derived` in docs/doc-map.md
# §A — only gen-roadmap-digest.js may write it. The dispatcher's roadmap-pair
# row catches the half-staged pair,
# check-digest-version.js catches a drifted stamp, and a hand-edit that keeps
# the stamp passed both.
#
# ARMED ON THE GENERATOR TOO, not just the two documents: a behaviour-changing
# edit to gen-roadmap-digest.js committed on its own would leave main carrying
# a digest no render reproduces, and the next roadmap commit would then be
# refused for a fault it did not cause. There is no direction gate here to
# soften that.
#
# Fed from the INDEX, generator included, for the digest-version gate's reason.
#
# Held and replayed on failure only. The digest-version gate above prints an OK
# line too and runs `live`; this gate's OK line names every path it reads, and
# stacked under that one it would put two green lines on every roadmap commit.
#
# `status`, not a flat code, so a generator that will not run (BROKEN, 2) stays
# distinguishable from a digest that drifted (1).
#
# DEFEAT: HUSKY=0 and `core.hooksPath` pointed off .husky/_ (the whole list:
# scripts/lib/commit-form.js's LIMITS, #800). A commit landing by either route
# is unchecked until roadmap-digest.yml's own digest-render step reaches it, on
# the next `lander/batch-<k>` push run or scheduled sweep (#2413, mantahostels#2895);
# `npm run check:digest-render` answers sooner.
if ! lander_batch && armed '^(docs/reference-roadmap\.html|docs/roadmap-digest\.md|\.claude/skills/roadmap-edit/scripts/gen-roadmap-digest\.js)$'; then
  # IN AN ADOPTER THE GENERATOR IS THE PLUGIN'S (#551): $WFC_PLUGIN_ROOT set
  # and naming neither this worktree's top nor the canonical checkout, which a
  # core worktree's plugin root may name. The host holds no copy, or one a
  # cut is deleting, so staging one out would refuse that deletion as a gate
  # input. The plugin's copy is read in place — no session edits an installed
  # plugin. The generator's path still arms the gate there.
  #
  # The hint's path is quoted, so a plugin root holding a space pastes whole.
  dr_gen_rel=.claude/skills/roadmap-edit/scripts/gen-roadmap-digest.js
  dr_paths='docs/reference-roadmap.html docs/roadmap-digest.md'
  dr_gen='"$sg_dir/gen-roadmap-digest.js"'
  dr_hint="$dr_gen_rel"
  # `|| :` stays outside the `$(…)`: inside it, shellcheck 0.9.0 flags SC2015,
  # which the local 0.11.0 does not (lucmoseley/mantahostels#3743).
  dr_plugin="$(cd "${WFC_PLUGIN_ROOT:-.}" 2>/dev/null && pwd -P)" || :
  dr_canon="$(cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd -P)"
  if [ -n "${WFC_PLUGIN_ROOT:-}" ] &&
    [ "$dr_plugin" != "$(pwd -P)" ] && [ "$dr_plugin" != "$dr_canon" ]; then
    dr_gen="\"\$WFC_PLUGIN_ROOT/$dr_gen_rel\""
    dr_hint="\"$WFC_PLUGIN_ROOT/$dr_gen_rel\""
  else
    dr_paths="$dr_paths $dr_gen_rel"
  fi
  staged_gate digest-render hold status "$dr_paths" \
    'node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-digest-render.js "$sg_dir/reference-roadmap.html" "$sg_dir/roadmap-digest.md" '"$dr_gen" \
    "  Those paths are staged copies. The digest is generated, never hand-edited:
  node $dr_hint docs/reference-roadmap.html --out docs/roadmap-digest.md"
fi

# A staged skills-lock.json is covered by the staged record of a completed
# `check-vendored-skills.js --upstream --write` run, its lock and licence-notice hashes
# matching (#2394, ruled at #2377). The index, not the worktree: the record
# vouches for the bytes this commit lands. Every path is optional: a deleted
# lock or manifest owes no record, and a missing record is the finding.
if armed '^skills-lock\.json$'; then
  staged_gate upstream-record live status \
    "opt:skills-lock.json opt:.claude/skills/THIRD-PARTY-NOTICES.md opt:.agents/vendored-upstream-pass.json opt:.agents/vendored-skill-edits.json" \
    'node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-vendored-skills.js --covered "$sg_dir"' ""
fi

# The limit that actually binds the injected payload, which the context-budget
# cap (the dispatcher's context-budget row) cannot read: it is PER COMMAND, and check-context-budget.js sums a union larger than
# any real variant (mantahostels#1915). This composes each command's payload from the
# STAGED text module and the rule fragments /code-review's rules read, and prints
# every command's margin against the harness's 10,000-character persistence
# threshold.
#
# IT PRINTS ON SUCCESS, unlike the context-budget row: crossing the threshold
# raises no error anywhere.
if armed '^(scripts/lib/tracker-inject-text\.js|docs/agents/rules/review-(dispatch-shape|deviations-read|finding-destination)\.txt)$'; then
  node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-injector-margin.js --index || exit "$?"
fi

# check-superseded-values.js exits BROKEN — not WARN — when a §B entry carries a
# `Supersedes` bullet with no key in docs/doc-map-superseded.json (mantahostels#861).
#
# --broken-only stops before the tracked-tree scan, so this gates on the staged
# map alone. Only the two files that mode opens are staged out: demanding the
# rest would let a rename of one disable the gate.
#
# A map blob that will not read is apparatus: warn and pass, leaving it to CI.
if armed '^(docs/doc-map\.md|docs/doc-map-superseded\.json)$'; then
  # The needle file is `opt:` — dropped on failure rather than skipping the
  # gate — so a truncated write cannot reach the checker as corrupt JSON and
  # report the wrong fault. Refusing with a flat 1 rather than the checker's
  # own status: here BROKEN *is* the finding.
  staged_gate superseded-needle hold 1 \
    'docs/doc-map.md opt:docs/doc-map-superseded.json' \
    'node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-superseded-values.js "$sg_dir/doc-map.md" --data-dir "$sg_dir" --broken-only' \
    "  Those paths are staged copies of docs/doc-map.md and docs/doc-map-superseded.json.
  Fix: give the entry a key in docs/doc-map-superseded.json whose needles are the
  values it supersedes, and commit the JSON alongside the map."
fi

# Type-checking, WARN-ONLY and always exit 0 (mantahostels#1062). Unlike the Biome gate
# above, tsc cannot be scoped to the commit's own staged paths: it needs a whole
# program, so it reads the WORKTREE — your unsaved edits outside the commit
# included.
#
# It never waits for the machine-wide type-check slot (#3278): this commit holds
# its index.lock throughout, so a wait here holds the commit open for as long
# as another run keeps the slot.
# WFC_TSC_NO_WAIT has a `queue-run.js --tsc` command try the slot once and exit
# 75 on a held one (lib/tsc-slot.js); any other command ignores it.
# queue-run.js's exit log records that refusal, and guard-typecheck-owed.js
# asks the session for a type-check at Stop (#3803).
# Residual: a declared command that exits 75 for a reason of its own is
# reported as a held slot, its output unshown.
#
# A RED try's stderr goes through whatever the commit was piped into, so
# record-typecheck-red.js keeps it for the session's next Bash answer (#3824).
#
# Armed on .js too, as tsconfig.json's checkJs takes it into the program (#3796).
# Residual: an adopter's .js outside its program pays for a run that reads nothing of it.
if ! lander_batch && armed '\.(js|ts|tsx|mts)$|^tsconfig\.json$'; then
  if declared_cmd node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/workflow-core-config.js command typecheck; then
    tc_cmd="$declared_command"
    tc_status=0
    tsc_out="$(WFC_TSC_NO_WAIT=1 sh -c "$tc_cmd" 2>&1)" || tc_status=$?
    if [ "$tc_status" -eq 75 ]; then
      echo "pre-commit: the type-check slot is held — $tc_cmd skipped, not waited for, as this commit holds .git/index.lock (#3278). ci.yml's Typecheck step is the gate." >&2
    elif [ "$tc_status" -ne 0 ]; then
      echo "pre-commit: $tc_cmd is RED — reporting only, this commit is NOT blocked." >&2
      printf '%s\n' "$tsc_out" >&2
      echo "  tsc reads the whole working tree, so the error may be in an unsaved file this commit does not carry (mantahostels#273)." >&2
      echo "  Re-run '$tc_cmd' before believing it. ci.yml's Typecheck step is the gate." >&2
      # `|| true`: a record that cannot be made must not refuse a gate that only reports.
      printf '%s\n' "$tsc_out" | node "${WFC_PLUGIN_ROOT:-.}"/scripts/record-typecheck-red.js -- "$tc_cmd" || true
    fi
  fi
fi

# ESLint, HARD-FAILING and scoped to the commit's own staged app/ and lib/ TS
# and scripts/ JS and TS paths (mantahostels#1133, #4642). Do not soften it to
# match the warn-only tsc gate above: that one reads a whole program and so
# every half-written file with it, where this one reads only the paths it is
# handed. eslint.config.mjs declares `files` for those directories alone, so
# the pattern mirrors that scope; a directory added there must be added here
# too, or the gate silently never fires on it.
#
# armed_live keeps deletions, and paths gone from the worktree, out of the path
# list; --no-error-on-unmatched-pattern covers one that goes between that read
# and ESLint's, where ESLint would otherwise exit 2 rather than on a finding.
# --no-warn-ignored keeps a path no config block takes, a scripts/ test file or
# an adopter's scripts/ with no block of its own, from failing as a warning.
#
# --max-warnings 0 because ESLint exits 0 on a warning — see package.json's
# comments["scripts.check:eslint"]. Spelled here rather than calling `npm run
# check:eslint`, which lints the whole configured scope where this lints the
# commit's.
#
# Known limit, shared with tsc: ESLint has no --staged, so it reads the WORKTREE
# copy of these paths, not the staged blob. Scoping keeps that to files this
# commit names, so the only divergence is your own further edits since staging.
#
# `commands.lint` switches this gate on; it does not name what runs (#2). The
# declared command lints the whole scope, where this gate lints the commit's
# own paths, so the gate keeps its own eslint call — and skips, saying so,
# where eslint is not on PATH.
if ! lander_batch && armed '^(app|lib)/.*\.(ts|tsx)$|^scripts/.*\.(js|mjs|cjs|ts)$'; then
  eslint_paths="$(armed_live)"
  if [ -n "$eslint_paths" ] &&
    declared_cmd node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/workflow-core-config.js command lint; then
    if ! command -v eslint >/dev/null 2>&1; then
      echo "SKIP: commands.lint is declared, but eslint is not on PATH" >&2
    else
      # shellcheck disable=SC2086 # deliberate word-splitting: one path per line.
      eslint --max-warnings 0 --no-warn-ignored --no-error-on-unmatched-pattern $eslint_paths || {
        echo "pre-commit: ESLint failed on this commit's own app/, lib/ or scripts/ paths." >&2
        echo "  These are this commit's own staged files: the gate reads no others (mantahostels#1133)." >&2
        exit 1
      }
    fi
  fi
fi

# The shell gate: HARD-FAILING shellcheck, scoped to the commit's own staged
# shell paths, not whole-repo (mantahostels#1134).
#
# Flags identical to package.json's check:sh, which owns their rationale. -x
# still resolves the `# shellcheck source=` directives when scoped: sources are
# followed DOWNWARD from each path given, so no lib needs to be in the path list
# to be read.
#
# armed_shell picks check:sh's file set from the staged paths (#1828).
#
# Two limits, both accepted at mantahostels#1134. shellcheck has no --staged, so it reads
# the WORKTREE copy; scoping keeps that to files this commit names, so the only
# divergence is your own edits since staging. And -x follows sources downward
# only, so editing scripts/lib/*.sh does not re-check its dependents — CI's
# whole-repo run catches that after the push. Widen to the whole set on
# a staged lib if it bites again (mantahostels#1134).
#
# Serialised with every other shellcheck run on the machine (#2579, #2627).
if ! lander_batch && armed_shell; then
  if tool_gate shellcheck "see CLAUDE.md §Gotchas for the aarch64 binary this machine uses."; then
    # shellcheck disable=SC2086 # one path per line.
    hook_bound sh "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/serialised.sh pre-commit shellcheck shellcheck -x --severity=style --exclude=SC2016 $tool_paths || {
      sc_rc=$?
      echo "pre-commit: shellcheck failed on this commit's own shell paths." >&2
      echo "  These are this commit's own staged files: the gate reads no others (mantahostels#1134)." >&2
      echo "  A broken guard fails OPEN, so nothing else would have reported this before CI." >&2
      exit "$sc_rc"
    }
  fi
fi

# The workflow gate: HARD-FAILING actionlint, scoped to the commit's own staged
# .github/workflows paths (mantahostels#1137).
#
# actionlint runs shellcheck over the shell inside `run:` blocks — which the
# gate above does not reach, its file set being shell files — and catches an
# undefined `needs:` job, a bad `if:` expression and an unknown runner label
# besides.
#
# Why this half exists at all when ci.yml has an actionlint step: a
# parseable-but-wrong scheduled-checks.yml stops the sweep, and the sweep is
# what would have run that step (mantahostels#1137).
#
# No flags, matching package.json's check:actions, which owns their rationale.
# Paths are passed explicitly here rather than letting actionlint discover the
# directory itself, which is the whole point of the scoping: a whole-directory
# run would fail this commit on a half-written workflow it does not carry. As with the shellcheck gate, actionlint has
# no --staged, so it reads the WORKTREE copy of the paths it is handed.
# actionlint is a Go binary with no npm route: the npm package of that name is
# an unrelated abandoned wrapper.
if ! lander_batch && armed '^\.github/workflows/.*\.ya?ml$'; then
  if tool_gate actionlint "see package.json's comments[\"scripts.check:actions\"] for the release to fetch."; then
    # shellcheck disable=SC2086 # one path per line.
    hook_bound actionlint $tool_paths || {
      echo "pre-commit: actionlint failed on this commit's own workflow paths." >&2
      echo "  These are this commit's own staged files: the gate reads no others (mantahostels#1137)." >&2
      exit 1
    }
  fi
fi

# The Python gate: HARD-FAILING ruff, scoped to the commit's own staged .py
# paths (mantahostels#1135), and charging only the findings the commit
# INTRODUCES — scripts/check-ruff-introduced.js lints each path's staged blob
# against its HEAD blob, and its header owns how (#122).
#
# The rule set lives in ruff.toml, which owns why it is what it is.
# No --select here, matching package.json's check:py — except in an adopter with
# no ruff config of its own, where ruff would otherwise run its defaults or a
# parent directory's config: there the plugin's ruff.toml is passed by --config
# (#106). An adopter excludes a directory by `ruffExclude` in
# .claude/workflow-core.json, not a root ruff.toml, which would switch this
# --config off (#122).
#
# The checker reads the staged paths itself and feeds ruff each blob on stdin,
# never letting ruff walk the tree: a walk would lint unstaged files the
# commit does not carry and refuse it for them, the failure #917 fixed in the
# host-root gate.
#
# A missing ruff refuses the commit unless a workflow runs `ruff check`, which
# then catches what slipped through (#1563); scripts/lib/formatters.js owns
# that reading and prints why. Not tool_gate, whose missing binary always
# passes. Workflows are read only where ruff is missing, so a malformed
# package.json cannot refuse a commit here.
if ! lander_batch && armed '\.py$' && [ -n "$(armed_live --index)" ]; then
  if ! command -v "${WFC_RUFF:-ruff}" >/dev/null 2>&1; then
    # A probe that prints no `lint:` line crashed: refuse rather than skip.
    lint_probe="$(node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/formatters.js lint-missing)" || lint_probe=""
    case "$lint_probe" in
      lint:skip) ;;
      lint:refuse) exit 2 ;;
      *)
        echo "pre-commit: the ruff probe failed, so the ruff gate refused this commit." >&2
        exit 2
        ;;
    esac
  else
    # The format gate below reads the same config through the same function.
    ruff_cfg="$(node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/formatters.js ruff-config)"
    node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-ruff-introduced.js ${ruff_cfg:+--config "$ruff_cfg"} || {
      ri_rc=$?
      # Residual: a checker crashing at load exits 1, so it still prints the findings text (#3812).
      if [ "$ri_rc" -ne 1 ]; then
        echo "pre-commit: the ruff gate refused this commit, its checker unable to run." >&2
        echo "  This is the tool, not your change: repair what the line above names, and commit again." >&2
      else
        echo "pre-commit: the ruff gate refused this commit's own Python paths." >&2
        echo "  Only findings HEAD's copy lacks are charged; ones already on it are not (#122)." >&2
        echo "  Machine-fixable findings: ruff check --fix <path>. Rule set: ${ruff_cfg:-your own ruff config}." >&2
        echo "  Fix the findings — never delete the code to pass (#1022). Vendored or third-party code alone goes in \`ruffExclude\` in .claude/workflow-core.json: it is not this repo's code to fix, and editing it forks it from upstream (#1463)." >&2
      fi
      exit "$ri_rc"
    }
  fi
fi

# The swallowed-error gate: HARD-FAILING base §N5 over the commit's own staged
# program-routed .py paths, charging only the `except` blocks it ADDS that
# neither raise nor exit and cite no ticket, narrow catches included, which
# ruff's BLE001 and E722 never see (#1830). The checker's header owns which
# paths are programs (`pythonRoutes`) and what a citation is. Its own block,
# not the ruff gate's: it needs python3, never ruff, and a missing python3
# refuses the commit.
if ! lander_batch && armed '\.py$' && [ -n "$(armed_live --index)" ]; then
  node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-swallowed-errors.js || {
    se_rc=$?
    if [ "$se_rc" -ne 1 ]; then
      echo "pre-commit: the swallowed-error gate refused this commit, its checker unable to run." >&2
    else
      echo "pre-commit: the swallowed-error gate refused this commit's own Python paths." >&2
      echo "  Say why at the site and cite the ticket that chose the swallow, or let the error raise or exit (base §N5)." >&2
    fi
    exit "$se_rc"
  }
fi

# The format gate: HARD-FAILING shfmt and `ruff format` over the commit's own
# staged shell and Python paths (#1332), as check:staged's Biome refuses
# unformatted JS and TS. scripts/check-format-staged.js reads each path's
# staged blob and prints the fix. The pattern is a cheap superset; the checker
# picks the shell paths by the shell gate's own lister. A commit only deleting such
# paths does not arm it, so a crashing probe below cannot refuse one.
#
# A missing formatter is BROKEN in the checker, refusing the commit with the
# line that installs it. The hook skips that half instead only where a
# workflow runs the formatter, which then catches what slipped through
# (#1354, #1463); scripts/lib/formatters.js owns that reading.
if ! lander_batch && armed "\.py\$|$GATE_SHELL_CANDIDATE" && [ -n "$(armed_live --index)" ]; then
  # A probe that prints no `flags:` line crashed: refuse rather than skip.
  fmt_probe="$(node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/formatters.js skip-flags)" || fmt_probe=""
  case "$fmt_probe" in
    flags:*) fmt_skip="${fmt_probe#flags:}" ;;
    *)
      echo "pre-commit: the formatter probe failed, so the format gate refused this commit." >&2
      exit 2
      ;;
  esac
  # shellcheck disable=SC2086 # deliberate word-splitting: zero to two flags.
  node "${WFC_PLUGIN_ROOT:-.}"/scripts/check-format-staged.js $fmt_skip || {
    fs_rc=$?
    # Residual: a checker crashing at load exits 1, so it still blames the staged paths (#3812).
    if [ "$fs_rc" -ne 1 ]; then
      echo "pre-commit: the format gate refused this commit, its checker unable to run." >&2
    else
      echo "pre-commit: the format gate refused this commit's own shell or Python paths." >&2
    fi
    exit "$fs_rc"
  }
fi

# Where a suite is gated at commit or the mutation hold is due, commit-paths
# runs this file down to the marker line below before either, so a gate
# refusing in seconds never waits behind them (#1763, #1910). So every core
# gate goes above it but those two, which commit-paths runs before the lock
# itself; below it, only they, the adopter's own gates and the stamp. commit-paths finds the line by its exact text, and runs no gates
# early where it is gone; nothing here reads a switch to stop at it.
# ---- end of the gates commit-paths runs before its suite ----

# The declared `commands.test`, HARD-FAILING, wherever it writes no test-pass
# marker (#740) — a repo's suite that pre-push's marker check can never see is
# otherwise gated by nothing. Where it does write one, the pre-push warning
# owns the suite and this skips; test-gate.js holds that line for both hooks.
# Last of the core gates, being the slowest.
#
# It runs in a throwaway worktree holding HEAD plus exactly the changes git
# handed this hook, as commit-paths' pre-lock run does, so an unsaved edit
# the commit does not carry cannot turn it red or green (#1766). Where that
# worktree cannot be made it runs in this checkout, saying so. Residual: a
# gitignored file the suite reads and `worktreeLinks` does not name turns it
# red, and a linked one stays live, so an edit to it mid-run reaches the suite
# (#1767).
#
# It stands down where $WFC_TEST_STAMP names a file directly in this checkout's git
# directory holding the key of exactly the changes git handed this hook
# (scripts/lib/commit-key.js, gate `test`) — a pre-lock run's green on them (#1650). The
# stamp is never consumed: commit-paths removes it as it exits.
if ! lander_batch && declared_cmd node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/test-gate.js commit; then
  tg_cmd="$declared_command"
  if ! tg_why="$(node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/commit-key.js stand-down test "$tg_stamp" 2>&1)"; then
    echo "pre-commit: running '$tg_cmd' in the lock — no pre-lock green stands it down: $tg_why." >&2
    tg_rc=0
    tg_inplace=0
    # `command node`: the suite runs under its own ceiling (#2667), past any checker limit (#4187).
    tg_out="$(command node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/isolated-worktree.js run "$tg_cmd")" || tg_rc=$?
    # 3 is the suite's red; 2 no worktree; anything else the runner itself failing.
    case "$tg_rc" in
      0 | 2 | 3) ;;
      *)
        printf '%s\n' "$tg_out" >&2
        echo "pre-commit: scripts/lib/isolated-worktree.js failed (exit $tg_rc) before the suite gave a verdict, so this commit is refused." >&2
        echo "  This is the runner, not your change: read its output above, and commit again once it runs." >&2
        exit 2
        ;;
    esac
    if [ "$tg_rc" -eq 2 ]; then
      echo "pre-commit: no worktree holds this commit's tree alone, so '$tg_cmd' runs in this checkout." >&2
      tg_rc=0
      tg_inplace=1
      tg_out="$(sh -c "$tg_cmd" </dev/null 2>&1)" || tg_rc=$?
    fi
    if [ "$tg_rc" -ne 0 ]; then
      printf '%s\n' "$tg_out" >&2
      # scripts/commit-paths.js prints these lines, worded for its own run, on
      # a pre-lock red, all but the mantahostels#273 pair: change both together.
      echo "pre-commit: the declared test command is RED — '$tg_cmd' — so this commit is refused." >&2
      if [ "$tg_inplace" -eq 1 ]; then
        echo "  It ran in this checkout, so the red may be an unsaved edit this commit does not carry (mantahostels#273)." >&2
        echo "  Fix the failing test, or save or set aside that edit, and commit again once it is green." >&2
      else
        echo "  It ran on HEAD plus this commit's own changes, so no unsaved edit outside them reached it (#1766): the red is in HEAD, in this commit, or in a gitignored file the suite needs that its worktree lacks." >&2
        echo "  Fix the failing test and commit again. Where the red is a gitignored file the worktree lacks, name it in \`worktreeLinks\` in .claude/workflow-core.json (#1767)." >&2
      fi
      exit 1
    fi
  fi
fi

# A commit changing a line on a declared sensitive path while a planted bug on
# it survives every test (#1906, spec #1871), with the `mutation` module on.
# Below the marker, so commit-paths does not run it among its early gates, and
# after the test gate, whose red it would only repeat more slowly. The script
# owns its skips, its throwaway worktree and its fail-open.
#
# It stands down as the test gate does, on $WFC_MUTATION_STAMP holding the
# key of exactly these changes for gate `mutation` — commit-paths' pre-lock
# green (#1910). No stamp named is a plain commit, and runs it in silence.
mh_why=""
if [ -z "$mh_stamp" ] || ! mh_why="$(node "${WFC_PLUGIN_ROOT:-.}"/scripts/lib/commit-key.js stand-down mutation "$mh_stamp" 2>&1)"; then
  if [ -n "$mh_why" ]; then
    echo "pre-commit: running the mutation hold in the lock — no pre-lock green stands it down: $mh_why." >&2
  fi
  # `command node`: Stryker runs under the hold's own timeout, past any checker limit (#4187).
  command node "${WFC_PLUGIN_ROOT:-.}"/scripts/mutation-hold-gate.js || exit "$?"
fi

# THE ADOPTER'S OWN GATES: `.husky/pre-commit.local` (#437). An adopter that
# wants a pre-commit gate of its own writes it there, never into this file,
# which an adopter runs from the plugin through its shim (#1839). The contract:
#   - it runs LAST, after every core gate has passed, and only if it exists;
#   - it is SOURCED, in this same `sh -e` shell, so `staged_gate` and this
#     hook's PATH are in scope, and any failing command or `exit 1` refuses
#     the commit;
#   - core never writes, copies or rewrites it — it is the adopter's to commit;
#   - before it runs, a script it names that the repo lacks refuses EVERY
#     commit, not just one staging the gate's arming path, where a missing
#     script would otherwise hide (scripts/lib/local-hook.sh, #426).
# An `exit 0` there ends the hook before the stamp below, so
# prepare-commit-msg runs every gate again: slow, never a skipped gate.
# `.husky/commit-msg.local` is the one other local file (#5142).
if [ -f .husky/pre-commit.local ]; then
  wfc_local_hook_refuse_missing .husky/pre-commit.local \
    "pre-commit: .husky/pre-commit.local calls a script this repo does not have:"
  # shellcheck source=/dev/null # the adopter's own optional gate, absent from most repos
  . ./.husky/pre-commit.local
fi

# The stand-down stamp (mantahostels#1705). `.husky/prepare-commit-msg` runs this whole file
# again, because that is the one hook that can refuse a commit and that
# `--no-verify` leaves running — so without a stamp every ordinary commit would run the ~14 gates twice. This is the last
# thing the file does, so it is written only when every gate above passed.
#
# Keyed to the INDEX TREE, not a pid or a timestamp: two distinct commits cannot
# share a tree object except in the empty-commit case, and there the content
# standing down is content these gates have already passed, which is the whole
# claim the key makes. `--absolute-git-dir` puts it per-worktree, beside
# MERGE_HEAD, so a sibling worktree can neither read it nor be stood down by it.
#
# Every failure here is swallowed: this file runs under `set -e`, where a
# failing write-tree — a conflicted index — would abort the hook and refuse a
# commit that has passed. A half-written stamp is worse than none, so the
# failing branch removes it. Failing to write one costs a second gate run,
# never a missed gate, which is the safe direction (mantahostels#103 §6).
pc_stamp_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || :)"
if [ -n "$pc_stamp_dir" ]; then
  git write-tree >"$pc_stamp_dir/wfc-precommit-stamp" 2>/dev/null ||
    rm -f "$pc_stamp_dir/wfc-precommit-stamp"
fi
