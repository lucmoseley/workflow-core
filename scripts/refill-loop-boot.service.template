[Unit]
Description=Restart the refill loop after a boot where no stop ended it

[Service]
Type=oneshot
RemainAfterExit=yes
# #3878. A login, interactive shell gives the loop what a typed start gets:
# ~/.bashrc, whose heap bound sits past its non-interactive return. Environment=
# holds what the profile does not set.
@ENVIRONMENT@
ExecStart=@SHELL@ -lic "exec node @SCRIPT@ boot-resume"
# Past any failure boot-resume itself could not log: code that will not load, or
# no node. Untraced: 25 lines holds node's load error and stack, measured at 17
# with systemd's own lines, and -b keeps out an earlier boot's.
ExecStopPost=/bin/sh -c 'if [ "$$SERVICE_RESULT" != success ]; then echo "$$(date -u +%%FT%%TZ) boot resume: the unit failed ($$EXIT_CODE $$EXIT_STATUS), its last journal lines follow" >> @LOG@; journalctl --user -u refill-loop-boot.service -b -n 25 -o cat --no-pager >> @LOG@ 2>&1; fi'
WorkingDirectory=%h
# The loop outlives this process and runs until `refill-loop.js stop`, so no
# stop of this unit, and no kill inside its cgroup, may take it down.
KillMode=process
OOMPolicy=continue
# The loop's sessions can run in this cgroup, which a default cap would count.
TasksMax=infinity

[Install]
WantedBy=default.target
