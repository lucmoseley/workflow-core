+/** @param {unknown} node @param {[number, number][]} within */
+function markLeads(node, within) {
+	if (typeof node !== "object" || node === null) return;
+	if (Array.isArray(node)) {
+		for (const n of node) markLeads(n, within);
+		return;
+	}
+	const n =
