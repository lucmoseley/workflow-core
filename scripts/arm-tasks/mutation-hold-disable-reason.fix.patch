+					cwd: root,
+					filename: path.join(root, filename),
+					sourceType: "module",
+					parserOpts: { plugins: [...(await pluginsFor(kind))] },
+					...(kind === "js" ? {} : { configFile: false, babelrc: false }),
+				});
