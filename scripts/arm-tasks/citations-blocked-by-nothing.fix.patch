 		if (!BLOCKER_LINE.test(line)) continue;
-		if (/\bnone\b/i.test(line)) continue;
+		if (statesNoBlocker(line)) continue;
 		if (/#\d+/.test(line) && !REFERRING_PHRASE.test(line.replace(CITED, " ")))
 			continue;
 		found.push(line.slice(0, 120));
