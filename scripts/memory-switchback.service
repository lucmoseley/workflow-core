[Unit]
Description=The memory-hold switchback (#4862): walk its schedule, resuming after a boot, a user manager restart or a kill
# Five failed starts in an hour is a fault no restart mends: stop and show it.
# A guess, not a measurement.
StartLimitIntervalSec=1h
StartLimitBurst=5

# One trial on one machine, so a copied unit, not a template and installer: it
# runs the main checkout's script as it stands at each start.
[Service]
WorkingDirectory=%h/workflow-core
ExecStart=/usr/bin/python3 scripts/memory_switchback.py run
# After a kill the script cannot see, no hold stays declared. A VM death leaves
# the file, which lib/meminfo.js ignores once its pid is gone.
ExecStopPost=/bin/rm -f %h/.claude/memory-hold
# A kill the script cannot see resumes (#4862). Exit 1 is a SIGTERM stop, the
# refusal of an ended trial or a crash, none of which a restart mends. 30 s is a
# guess: long enough that a crash at start reaches the start limit slowly.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1
# What a typed start gets, against the manager's default of 200, which puts the
# runner first in earlyoom's order (#4130).
OOMScoreAdjust=0

[Install]
WantedBy=default.target
